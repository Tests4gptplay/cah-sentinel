<Window x:Class="CAHSentinel.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CAH Sentinel · 本地设置" Width="580" Height="460"
    WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F7F5FC">
  <Grid Margin="20">
    <StackPanel>
      <TextBlock Text="CAH Sentinel v0.0.6 · 仅本地" FontSize="18" FontWeight="Bold" Foreground="#4D416C"/>
      <TextBlock Margin="0,4,0,15" Text="只读取本机 CAH 状态。无需私有库地址、登录或云端同步。" Foreground="#615A70"/>
      <TextBlock Text="CAH 本地仓库根目录（程序不会修改它）"/>
      <Grid Margin="0,4,0,13">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="LocalPathField" Padding="6" Grid.Column="0"/>
        <Button Content="浏览…" Width="75" Padding="6" Margin="8,0,0,0"
            Grid.Column="1" Click="OnBrowse"/>
      </Grid>
      <TextBlock Text="本地 GIF 素材包（可选；不自动下载或打包）"/>
      <Grid Margin="0,4,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SpritePackField" Padding="6"/>
        <Button Content="浏览…" Width="75" Margin="8,0,0,0" Grid.Column="1" Click="OnBrowsePack"/>
      </Grid>
      <CheckBox x:Name="ReducedMotionField" Content="减少动态（只显示首帧）" Margin="0,0,0,10"/>
      <TextBlock Text="Foreground 对话链接（可选；只保存在本机）"/>
      <TextBox x:Name="ForegroundField" Margin="0,4,0,13" Padding="6"/>
      <StackPanel Orientation="Horizontal" Margin="0,3,0,6">
        <CheckBox x:Name="NotificationField" Content="Windows 提醒" Margin="0,0,18,0"/>
        <CheckBox x:Name="MonitorField" Content="启用监控" Margin="0,0,18,0"/>
        <CheckBox x:Name="PetField" Content="显示桌宠"/>
      </StackPanel>
      <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#675D78" TextWrapping="Wrap"
        Text="CAH 本地 FETCH_HEAD 超过 5 分钟未更新时，显示状态过期，不把旧数据冒充实时状态。"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="取消" Width="80" Padding="8" Margin="0,0,10,0" IsCancel="True"/>
        <Button Content="保存" Width="86" Padding="8" IsDefault="True" Click="OnSave"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
