<Window x:Class="CAHSentinel.PetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CAH Sentinel" Width="140" Height="210"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
    Loaded="OnLoaded" Closing="OnClosing"
    MouseLeftButtonDown="OnMouseLeftButtonDown"
    MouseRightButtonUp="OnMouseRightButtonUp">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="165"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Image x:Name="PetImage" Width="137" Height="165" Stretch="Uniform"
      HorizontalAlignment="Center" VerticalAlignment="Top"/>
    <TextBlock x:Name="Placeholder" Text="✦" FontSize="55" FontWeight="Bold"
      Foreground="#AA9378C5" HorizontalAlignment="Center"
      VerticalAlignment="Center" Visibility="Collapsed"/>
    <Border Grid.Row="1" Background="#EBFAF7FF" CornerRadius="7"
      BorderBrush="#887D6B97" BorderThickness="1"
      Padding="5,3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
      MaxWidth="138" Margin="1,2,1,0">
      <StackPanel>
        <TextBlock x:Name="StateLabel" Text="CAH Sentinel"
          FontWeight="SemiBold" FontSize="12" Foreground="#433B5B"/>
        <TextBlock x:Name="TaskLabel" Text="" FontSize="10"
          Foreground="#574C72" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
