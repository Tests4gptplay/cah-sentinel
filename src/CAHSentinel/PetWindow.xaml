<Window x:Class="CAHSentinel.PetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CAH Sentinel" Width="280" Height="350"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
    Loaded="OnLoaded" Closing="OnClosing"
    MouseLeftButtonDown="OnMouseLeftButtonDown"
    MouseRightButtonUp="OnMouseRightButtonUp">
  <Grid>
    <Image x:Name="PetImage" Width="274" Height="330" Stretch="Uniform"
      HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
    <TextBlock x:Name="Placeholder" Text="✦" FontSize="110" FontWeight="Bold"
      Foreground="#AA9378C5" HorizontalAlignment="Center"
      VerticalAlignment="Center" Visibility="Collapsed"/>
    <Border Background="#EBFAF7FF" CornerRadius="13"
      BorderBrush="#887D6B97" BorderThickness="1"
      Padding="9,5" HorizontalAlignment="Right" VerticalAlignment="Top"
      MaxWidth="260" Margin="4">
      <StackPanel>
        <TextBlock x:Name="StateLabel" Text="CAH Sentinel"
          FontWeight="SemiBold" FontSize="12" Foreground="#433B5B"/>
        <TextBlock x:Name="TaskLabel" Text="" FontSize="10"
          Foreground="#574C72" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
